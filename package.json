{
  "name": "slopdirector-opencode",
  "version": "0.1.0",
  "private": true,
  "description": "SlopDirector: an agent-driven filmmaking harness on the SlopStudio NLE (Electron + Next.js + ffmpeg + MCP), tuned for OpenCode on macOS.",
  "main": "electron/main.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed-perf": "tsx --env-file=.env scripts/seed-perf-project.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "gen-enums": "node scripts/gen-enums.mjs",
    "db:sqlite:derive": "node scripts/derive-sqlite-schema.mjs",
    "db:sqlite:ddl": "node scripts/gen-desktop-ddl.mjs",
    "db:sqlite:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:sqlite:migrate": "prisma migrate dev --schema prisma/schema.sqlite.prisma",
    "desktop:dev": "node scripts/launch-local.mjs --dev",
    "desktop:start": "cross-env ELECTRON_DEV=1 electron electron/main.js",
    "desktop:standalone": "node scripts/build-desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs && bash scripts/fetch-ffmpeg.sh && electron-builder --linux AppImage",
    "desktop:build:win": "node scripts/build-desktop.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-ffmpeg.ps1 && node scripts/package-desktop.mjs --win nsis --x64",
    "desktop:build:mac": "node scripts/build-desktop.mjs && bash scripts/fetch-ffmpeg.sh && node scripts/package-desktop.mjs --mac dmg",
    "codex:setup": "node scripts/setup-codex.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:windows": "tsx --test tests/platform/windows.test.ts",
    "test:motion": "tsx --test tests/platform/motion.test.ts",
    "test:interview": "tsx --test tests/platform/interview.test.ts",
    "test:director-style": "tsx --test tests/platform/director-style.test.ts",
    "test:typography": "tsx --test tests/platform/typography.test.ts",
    "test:source-music": "tsx --test tests/platform/source-music.test.ts",
    "test:trailer": "tsx --test tests/platform/trailer-constraints.test.ts",
    "test:platform": "tsx --test tests/platform/director-style.test.ts tests/platform/interview.test.ts tests/platform/motion.test.ts tests/platform/source-music.test.ts tests/platform/trailer-constraints.test.ts tests/platform/typography.test.ts tests/platform/windows.test.ts",
    "test:e2e": "playwright test",
    "test:eval": "tsx tests/eval/run.ts",
    "test:mcp": "tsx tests/mcp/run.ts",
    "mcp": "node mcp/run.cjs",
    "serve:headless": "node scripts/launch-local.mjs --headless",
    "test:e2e:ui": "playwright test --ui",
    "desktop:prod": "node scripts/launch-local.mjs --prod"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^6.19.3",
    "next": "16.3.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rnd": "10.5.3",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.slopdirector.opencode",
    "productName": "SlopStudio Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": "prisma/desktop-schema.sql",
        "to": "desktop-schema.sql"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffprobe",
          "*.exe",
          "LICENSE*",
          "SOURCE*"
        ]
      }
    ],
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": ".data/windows-runtime/node_modules",
          "to": "standalone/node_modules"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.video",
      "identity": null,
      "extraResources": [
        {
          "from": ".next/standalone/node_modules",
          "to": "standalone/node_modules"
        }
      ]
    },
    "linux": {
      "extraResources": [
        {
          "from": ".next/standalone/node_modules",
          "to": "standalone/node_modules"
        }
      ],
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  }
}
