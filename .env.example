# SlopDirector — environment template. Copy to `.env` (which is git-ignored) and fill in
# what you use. Nothing in this file is required to launch the desktop app; the launchers
# create the SQLite database, the asset folder and an AUTH_SECRET themselves.
# Full reference: docs/DEPENDENCIES.md ("Environment variables").

# --- AI generation (optional) -------------------------------------------------------
# OpenRouter drives the LLM / AI-video / fallback-TTS pipeline (Grok Voice narration).
OPENROUTER_API_KEY=

# ElevenLabs as the house narrator. When the key is set it becomes the default for the
# Voiceover panel, the TTS job and MCP `generate_narration`; leave it empty to fall back
# to Grok Voice via OpenRouter.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=           # a voice id from your ElevenLabs library (default: the catalogue's "British Guy Documentary")
# ELEVENLABS_MODEL_ID=eleven_v3
# ELEVENLABS_STYLE_TAG=[serious]  # v3 audio tag prepended to each take; "" disables
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_SPEED=1
# ELEVENLABS_CONDITION=highpass=f=65,loudnorm=I=-16:TP=-2:LRA=7
# SLOPSTUDIO_TTS_MODEL=           # pin the default narrator explicitly, e.g. elevenlabs/eleven_v3
# SLOPSTUDIO_TTS_VOICE=
# NEXT_PUBLIC_DEFAULT_TTS_MODEL=  # build-time default for the model pickers

# --- Media tools ---------------------------------------------------------------------
# ffmpeg/ffprobe: vendor/ffmpeg/ (from scripts/fetch-ffmpeg.sh|.ps1) wins, then PATH. On macOS do NOT
# rely on Homebrew's ffmpeg: it lacks the drawtext and ass filters. Override if needed:
# SLOPSTUDIO_FFMPEG_DIR=/opt/homebrew/bin
# SLOPSTUDIO_FFMPEG_PATH=
# yt-dlp is found on PATH (`brew install yt-dlp`); override the binary:
# YTDLP_BIN=
# Read YouTube cookies from a browser profile for age/region-gated imports, e.g. chrome, safari, firefox
# YTDLP_COOKIES_FROM_BROWSER=
# Longest window a single import_youtube may fetch (seconds)
# YT_IMPORT_MAX_SECONDS=300
# YT_IMPORT_CONCURRENCY=2
# VIDEO_ENCODER=auto              # auto | x264 | vaapi | nvenc | qsv (auto picks x264 on macOS)

# --- Audio Studio (optional: Demucs stem separation + Whisper captions) --------------
# Python interpreter of the venv that has demucs / openai-whisper / torchcodec installed.
# SLOPSTUDIO_PYTHON=~/.slopstudio-py/bin/python
# SLOPSTUDIO_DEMUCS_ARGV=
# SLOPSTUDIO_WHISPER_ARGV=
# WHISPER_CONCURRENCY=1

# --- Agent / MCP ---------------------------------------------------------------------
# The MCP server talks to the running app here (matches opencode.json / .mcp.json).
# SLOPSTUDIO_URL=http://127.0.0.1:38473
# SLOPSTUDIO_AGENT_NAME=OpenCode
# SLOPSTUDIO_AGENT_FEED=1         # 0 turns off the Agent-panel activity feed
# SLOPSTUDIO_API_TOKEN=           # only for a remote/headless server that requires a bearer token

# --- Desktop / storage (the launchers set these; override only if you know why) -----
# SLOPSTUDIO_DESKTOP=1
# SLOPSTUDIO_DB=sqlite
# DATABASE_URL=file:./.data/slopstudio.db
# ASSET_ROOT=./.data/assets
# SLOPSTUDIO_PORT=38473
# WORKER_ENABLED=true
# AUTH_SECRET=                    # generated per install by the desktop launcher
