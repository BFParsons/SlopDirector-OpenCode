# Normalise line endings so a checkout on macOS/Linux gets LF (CRLF in a shell
# script breaks `bash: bad interpreter`), while Windows-only scripts keep CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.m4a binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.db binary
*.zip binary
