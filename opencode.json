{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/HARNESS-LOOP.md"],
  "mcp": {
    "slopstudio": {
      "type": "local",
      "command": ["node", "mcp/run.cjs"],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "SLOPSTUDIO_URL": "http://127.0.0.1:38473",
        "SLOPSTUDIO_AGENT_NAME": "OpenCode"
      }
    }
  }
}
