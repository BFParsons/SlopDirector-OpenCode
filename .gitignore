# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local data: user-owned postgres instance + generated assets
/.data
/output/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secrets: YouTube cookie jars (server-owned)
yt-cookies.txt
cookies.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA artifacts (playwright-qa scratch scripts + screenshots)
/qa/
/qa-screenshots/
qa-*.py

# desktop (Electron) build output + derived SQLite client
/dist
/release
/src/generated

# local Claude Code permission settings (machine-specific)
/.claude/settings.local.json

# Bundled static ffmpeg/ffprobe for the desktop AppImage (fetched via scripts/fetch-ffmpeg.sh)
/vendor/ffmpeg/ffmpeg
/vendor/ffmpeg/ffprobe
/vendor/ffmpeg/*.exe
/vendor/ffmpeg/LICENSE*
/vendor/ffmpeg/SOURCE*

# Generated Codex configuration contains absolute paths for this checkout.
/.codex/config.toml

# Playwright
/test-results
/playwright-report

# eval harness scratch media
tests/eval/.tmp/

# The template is the one env file that IS tracked; real values live in .env (ignored).
!.env.example

# Generated OpenCode state, if any host writes it here
/.opencode/node_modules
